{
  "expo": {
    "name": "MemQ",
    "slug": "memq",
    "version": "1.0.3",
    "orientation": "portrait",
    "scheme": "memq",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.river.memq",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "6"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
