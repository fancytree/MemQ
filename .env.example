# Copy to .env and fill in (local dev). EAS production uses eas.json production.env or EAS Secrets.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_your_ios_public_key_here
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_your_android_public_key_here

# Connecting MemQ to an app that speaks MCP. Off unless ENABLED is exactly "true":
# that flag hides both Connected apps under Settings and the guidance on New Lesson,
# so a build without it says nothing about connecting at all.
# EXPO_PUBLIC_MCP_ENABLED=true
# Where the app manages existing connections.
# EXPO_PUBLIC_MCP_BROKER_URL=https://...
# The address a person enters in the other app. Shown in the guidance only when set,
# so the steps never name a server this build cannot point at.
# EXPO_PUBLIC_MCP_SERVER_URL=https://...
